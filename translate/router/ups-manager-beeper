#!/bin/sh
# Управление звуком (зуммером) ИБП через NUT.
# Команда beeper.toggle переключает состояние, поэтому toggle отправляется
# только тогда, когда текущее состояние не совпадает с желаемым.
#
# Использование:
#   ups-manager-beeper status              -> enabled | disabled
#   ups-manager-beeper set on|off          -> привести звук к состоянию (однократно)
#   ups-manager-beeper enforce             -> режим "постоянно" и расписание (вызывается службой)

CONF=ups_manager
TARGET_UPS=$(uci -q get ${CONF}.ups.name || echo ups)
HOST=127.0.0.1
PORT=3493
UPS="${TARGET_UPS}@${HOST}:${PORT}"
RUNTIME_DIR=/tmp/run/ups-manager
LOG_SCRIPT=/usr/bin/ups-manager-log-event

log() {
	[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "beeper" "info" "Звук ИБП" "$1"
	logger -t ups-manager "[beeper] $1"
}

get_state() {
	upsc "$UPS" ups.beeper.status 2>/dev/null
}

# Отправляет toggle от имени admin (пароль из настроек пакета)
send_toggle() {
	local pass
	pass=$(uci -q get ${CONF}.nut_service.admin_password)
	[ -n "$pass" ] || { log "Нет пароля admin в настройках пакета"; return 1; }
	upscmd -u admin -p "$pass" "$UPS" beeper.toggle >/dev/null 2>&1
}

# Привести звук к нужному состоянию: toggle только при несовпадении
ensure_state() {
	local want="$1" cur
	cur=$(get_state)
	case "$cur" in
		enabled|disabled) ;;
		*) log "Статус звука недоступен (UPS не отвечает)"; return 1 ;;
	esac
	if [ "$want" = "enabled" ] && [ "$cur" = "enabled" ]; then return 0; fi
	if [ "$want" = "disabled" ] && [ "$cur" = "disabled" ]; then return 0; fi

	send_toggle || return 1
	sleep 3
	cur=$(get_state)
	if [ "$cur" = "$want" ]; then
		log "Звук переведён в состояние: $want"
		return 0
	fi
	log "Не удалось перевести звук в состояние $want (сейчас $cur)"
	return 1
}

# Текущее время роутера (часовой пояс берётся из системы)
now_hm() {
	date +%H:%M
}

# Сравнение HH:MM как минут
to_min() {
	local h m
	h=$(echo "$1" | cut -d: -f1)
	m=$(echo "$1" | cut -d: -f2)
	# BusyBox ash не понимает 10#: убираем ведущие нули через sed
	h=$(echo "$h" | sed 's/^0*//'); [ -n "$h" ] || h=0
	m=$(echo "$m" | sed 's/^0*//'); [ -n "$m" ] || m=0
	echo $((h * 60 + m))
}

# Желаемое состояние по расписанию: между off_at и on_at звук выключен
schedule_state() {
	local off_at on_at now off_m on_m cur_m
	off_at=$(uci -q get ${CONF}.beeper.schedule_off || echo "")
	on_at=$(uci -q get ${CONF}.beeper.schedule_on || echo "")
	[ -n "$off_at" ] && [ -n "$on_at" ] || { echo ""; return; }
	now=$(now_hm)
	off_m=$(to_min "$off_at")
	on_m=$(to_min "$on_at")
	cur_m=$(to_min "$now")
	if [ "$off_m" -lt "$on_m" ]; then
		# обычный интервал, например 09:00-17:00
		if [ "$cur_m" -ge "$off_m" ] && [ "$cur_m" -lt "$on_m" ]; then echo "disabled"; else echo "enabled"; fi
	else
		# интервал через полночь, например 23:00-07:00
		if [ "$cur_m" -ge "$off_m" ] || [ "$cur_m" -lt "$on_m" ]; then echo "disabled"; else echo "enabled"; fi
	fi
}

case "$1" in
	status)
		get_state
		;;
	schedule-now)
		schedule_state
		;;
	set)
		case "$2" in
			on)  ensure_state enabled ;;
			off) ensure_state disabled ;;
			*) echo "Usage: $0 set on|off"; exit 1 ;;
		esac
		;;
	enforce)
		mode=$(uci -q get ${CONF}.beeper.mode || echo "off")
		case "$mode" in
			permanent_off)
				ensure_state disabled
				;;
			schedule)
				want=$(schedule_state)
				[ -n "$want" ] && ensure_state "$want"
				;;
			*)
				# режим "обычный" или "однократно": ничего не делаем
				;;
		esac
		;;
	*)
		echo "Usage: $0 {status|set on|off|enforce}"
		exit 1
		;;
esac
exit 0
