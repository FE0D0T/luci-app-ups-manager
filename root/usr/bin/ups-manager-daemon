#!/bin/sh
# UPS Background Daemon
# Copyright (C) 2026 Gilbert Liu & Contributors

CONF="ups_manager"
RUNTIME_DIR="/tmp/run/ups-manager"
LOG_DIR="/tmp/log/ups-manager"
STATUS_FILE="${RUNTIME_DIR}/status.json"
HISTORY_FILE="${RUNTIME_DIR}/history.json"
ENERGY_FILE="${RUNTIME_DIR}/energy.json"
EVENT_LOG="${LOG_DIR}/events.log"
NOTIFY_SCRIPT="/usr/bin/ups-manager-notify"
SHUTDOWN_SCRIPT="/usr/bin/ups-manager-shutdown"
LOG_SCRIPT="/usr/bin/ups-manager-log-event"

mkdir -p "$RUNTIME_DIR" "$LOG_DIR" 2>/dev/null

uci_get() {
	if command -v uci >/dev/null 2>&1; then
		uci -q get "$1" 2>/dev/null
	else
		echo "$2"
	fi
}

uci_get_energy_val() {
	if [ -f "$ENERGY_FILE" ]; then
		awk -v k="$1" -v d="$2" 'BEGIN{v=d} { if (match($0, "\"" k "\":[0-9.]+")) { s=substr($0, RSTART, RLENGTH); sub(".*:", "", s); v=s } } END{ print v }' "$ENERGY_FILE"
	else
		echo "$2"
	fi
}

# Фиксация отклонений качества электроэнергии (пороги из UCI quality_policy).
# Состояние каждого правила хранится в QSTATE_<имя>=0|1, чтобы не писать дубли.
quality_check() {
	local name="$1" val="$2" trig="$3" rec="$4" dir="$5" title="$6" sev="$7"
	[ -n "$val" ] || return 0
	local var="QSTATE_$name"
	eval "local cur=\${$var:-0}"
	local bad=0
	if [ "$dir" = "low" ]; then
		if [ "$cur" = "0" ]; then [ "$(awk "BEGIN{print ($val < $trig)}")" = "1" ] && bad=1; else [ "$(awk "BEGIN{print ($val < $rec)}")" = "1" ] && bad=1; fi
	else
		if [ "$cur" = "0" ]; then [ "$(awk "BEGIN{print ($val > $trig)}")" = "1" ] && bad=1; else [ "$(awk "BEGIN{print ($val > $rec)}")" = "1" ] && bad=1; fi
	fi
	if [ "$bad" = "1" ] && [ "$cur" = "0" ]; then
		eval "$var=1"; eval "QSTART_$name=$NOW"
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" quality "$title" "$sev" "$val" "ongoing" "" "Отклонение началось"
	elif [ "$bad" = "0" ] && [ "$cur" = "1" ]; then
		eval "$var=0"
		eval "local st=\${QSTART_$name:-$NOW}"
		local dur=$((NOW - st))
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" quality "$title" "$sev" "$val" "recovered" "${dur} с" "Параметр вернулся в норму"
	fi
}

# Правила статуса ИБП: флаг в ups.status = отклонение. Уровень из UCI quality_policy.
status_rule() {
	local key="$1" present="$2" title="$3" default_sev="$4"
	local sev
	sev=$(uci_get "${CONF}.quality.$key" "$default_sev")
	local var="SSTATE_$key"
	eval "local cur=\${$var:-0}"
	if [ "$present" = "1" ] && [ "$cur" = "0" ]; then
		eval "$var=1"; eval "SSTART_$key=$NOW"
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" quality "$title" "$sev" "$STATUS_VAL" "ongoing" "" "Флаг статуса ИБП появился"
	elif [ "$present" = "0" ] && [ "$cur" = "1" ]; then
		eval "$var=0"
		eval "local st=\${SSTART_$key:-$NOW}"
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" quality "$title" "$sev" "$STATUS_VAL" "recovered" "$((NOW - st)) с" "Флаг статуса ИБП снят"
	fi
}

log_event() {
	local level="$1"
	local msg="$2"
	local ts=$(date "+%Y-%m-%d %H:%M:%S")
	echo "[$ts] [$level] $msg" >> "$EVENT_LOG"
	logger -t ups-manager "[$level] $msg"
	# Keep event log size reasonable (max 2000 lines)
	if [ $(wc -l < "$EVENT_LOG" 2>/dev/null || echo 0) -gt 2500 ]; then
		tail -n 1500 "$EVENT_LOG" > "${EVENT_LOG}.tmp" && mv "${EVENT_LOG}.tmp" "$EVENT_LOG"
	fi
}

trap 'log_event INFO "Daemon stopping..."; rm -f /tmp/run/ups-manager.pid; exit 0' INT TERM

echo $$ > /tmp/run/ups-manager.pid
log_event INFO "UPS Manager daemon v1.0.5 started."
[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "ops" "info" "Запуск демона UPS" "Фоновый сборщик данных UPS Manager запущен и работает."

PREV_ONLINE=1
PREV_ON_BATTERY=0
PREV_LOW_BATTERY=0
ON_BATTERY_START_TS=0
LAST_FLUSH_TS=$(date +%s)
LAST_MIN_TS=$(date +%s)
# Накопление энергии (Wh): сутки и месяц, сброс по смене даты/месяца
LAST_E_TS=$(date +%s)
TODAY_DATE=$(date +%Y-%m-%d)
MONTH_KEY=$(date +%Y-%m)
TODAY_WH=$(uci_get_energy_val today_wh 0)
MONTH_WH=$(uci_get_energy_val month_wh 0)

LAST_NOTIFY_TS=0

# Initialize history file if empty
if [ ! -s "$HISTORY_FILE" ]; then
	echo '{"points":[]}' > "$HISTORY_FILE"
fi

# Initialize energy file if empty
if [ ! -s "$ENERGY_FILE" ]; then
	echo '{"today_kwh":0.00,"month_kwh":0.00,"peak_power":0.0,"avg_power":0.0,"history":[]}' > "$ENERGY_FILE"
fi

get_field() {
	echo "$1" | awk -F': ' -v k="$2" '$1==k{print $2}'
}

while true; do
	ENABLED=$(uci_get "${CONF}.global.enabled" "1")
	if [ "$ENABLED" != "1" ]; then
		sleep 10
		continue
	fi

	POLL_INTERVAL=$(uci_get "${CONF}.global.poll_interval" "3")
	[ "$POLL_INTERVAL" -ge 1 ] 2>/dev/null || POLL_INTERVAL=3

	UPS_NAME=$(uci_get "${CONF}.ups.name" "ups")
	UPS_HOST=$(uci_get "${CONF}.ups.remote_host" "127.0.0.1")
	UPS_PORT=$(uci_get "${CONF}.ups.remote_port" "3493")
	TARGET="${UPS_NAME}@${UPS_HOST}:${UPS_PORT}"

	NOW=$(date +%s)
	RAW=$(upsc "$TARGET" 2>/dev/null)
	UPSC_EXIT=$?

	if [ $UPSC_EXIT -ne 0 ]; then
		# UPS Communication lost
		if [ $PREV_ONLINE -eq 1 ]; then
			log_event WARN "Lost communication with UPS ($TARGET)."
			[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "comm" "warn" "⚠️ Тревога: связь с ИБП потеряна, устройство офлайн!" "Связь с ИБП не восстановилась за период опроса. Возможно, отключён USB-порт платы или драйвер NUT."
			if [ -x "$NOTIFY_SCRIPT" ]; then
				"$NOTIFY_SCRIPT" "comm_lost" "Связь с ИБП потеряна: не удаётся подключиться к $TARGET" &
			fi
			PREV_ONLINE=0
		fi
		cat <<EOF > "$STATUS_FILE"
{"connected":false,"online":false,"status":"COMM_LOST","updated_at":$NOW}
EOF
		sleep "$POLL_INTERVAL"
		continue
	fi

	if [ $PREV_ONLINE -eq 0 ]; then
		log_event INFO "Restored communication with UPS ($TARGET)."
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "comm" "success" "⚡ Связь с ИБП восстановлена" "Связь с ИБП ($TARGET) восстановлена, устройство снова онлайн."
		if [ -x "$NOTIFY_SCRIPT" ]; then
			"$NOTIFY_SCRIPT" "comm_restored" "Связь с ИБП восстановлена: $TARGET" &
		fi
		PREV_ONLINE=1
	fi

	STATUS_VAL=$(get_field "$RAW" "ups.status")
	CHARGE=$(get_field "$RAW" "battery.charge")
	RUNTIME=$(get_field "$RAW" "battery.runtime")
	BATTERY_V=$(get_field "$RAW" "battery.voltage")
	INPUT_V=$(get_field "$RAW" "input.voltage")
	INPUT_FREQ=$(get_field "$RAW" "input.frequency")
	OUTPUT_V=$(get_field "$RAW" "output.voltage")
	OUTPUT_FREQ=$(get_field "$RAW" "output.frequency")
	LOAD_PCT=$(get_field "$RAW" "ups.load")
	TEMP=$(get_field "$RAW" "ups.temperature")
	MODEL=$(get_field "$RAW" "device.model")
	[ -z "$MODEL" ] && MODEL=$(get_field "$RAW" "ups.model")
	MFR=$(get_field "$RAW" "device.mfr")
	[ -z "$MFR" ] && MFR=$(get_field "$RAW" "ups.mfr")
	REAL_POWER=$(get_field "$RAW" "ups.realpower")

	IS_OL=0
	IS_OB=0
	IS_LB=0
	case "$STATUS_VAL" in *OL*) IS_OL=1 ;; esac
	case "$STATUS_VAL" in *OB*) IS_OB=1 ;; esac
	case "$STATUS_VAL" in *LB*) IS_LB=1 ;; esac

	# Universal Multi-Tier Power Calculation Engine
	HW_NOM_POWER=$(get_field "$RAW" "ups.realpower.nominal")
	HW_NOM_VA=$(get_field "$RAW" "ups.power.nominal")
	HW_CURRENT=$(get_field "$RAW" "output.current")
	HW_VOLTAGE=$(get_field "$RAW" "output.voltage")
	USER_NOM_POWER=$(uci_get "${CONF}.ups.nominal_power" "")
	POWER_SCALE=$(uci_get "${CONF}.ups.power_scale" "1.0")

	POWER="$REAL_POWER"
	POWER_ESTIMATED=0
	POWER_SOURCE="unknown"
	NOMINAL_POWER=""

	if [ -n "$POWER" ] && [ "$POWER" != "0" ]; then
		# Tier 1: True hardware sensor
		POWER_SOURCE="sensor"
		POWER_ESTIMATED=0
	elif [ -n "$HW_CURRENT" ] && [ -n "$HW_VOLTAGE" ] && [ "$HW_CURRENT" != "0" ]; then
		# Tier 2: Output Current & Voltage calculation
		POWER=$(awk "BEGIN {printf \"%.1f\", $HW_VOLTAGE * $HW_CURRENT * 0.9 * ${POWER_SCALE:-1.0}}" 2>/dev/null)
		POWER_SOURCE="current_calc"
		POWER_ESTIMATED=0
	else
		# Tier 3: Rated Capacity × Load% Decision Tree
		POWER_ESTIMATED=1

		# 3.1 User manually specified nominal power
		if [ -n "$USER_NOM_POWER" ] && [ "$USER_NOM_POWER" -gt 0 ] 2>/dev/null; then
			NOMINAL_POWER="$USER_NOM_POWER"
			POWER_SOURCE="user_defined"
		# 3.2 Firmware reported realpower.nominal
		elif [ -n "$HW_NOM_POWER" ] && [ "$HW_NOM_POWER" -gt 0 ] 2>/dev/null; then
			NOMINAL_POWER="$HW_NOM_POWER"
			POWER_SOURCE="firmware_watts"
		# 3.3 Firmware reported power.nominal VA
		elif [ -n "$HW_NOM_VA" ] && [ "$HW_NOM_VA" -gt 0 ] 2>/dev/null; then
			pf=0.6
			case "$MODEL" in *Online*|*RT*|*C1K*|*C2K*|*C3K*|*C6K*) pf=0.8 ;; esac
			NOMINAL_POWER=$(awk "BEGIN {printf \"%d\", $HW_NOM_VA * $pf}" 2>/dev/null)
			POWER_SOURCE="firmware_va"
		# 3.4 Smart Model Signature Extraction
		else
			POWER_SOURCE="model_inferred"
			m_upper=$(echo "$MODEL" | tr 'a-z' 'A-Z')
			case "$m_upper" in
				*10K*|*10000*) NOMINAL_POWER=9000 ;;
				*6K*|*6000*) NOMINAL_POWER=5400 ;;
				*3K*|*3000*) NOMINAL_POWER=2400 ;;
				*2K*|*2200*|*2000*) NOMINAL_POWER=1600 ;;
				*1500*) NOMINAL_POWER=900 ;;
				*1200*) NOMINAL_POWER=720 ;;
				*1000*|*1K*) NOMINAL_POWER=600 ;;
				*850*) NOMINAL_POWER=510 ;;
				*800*) NOMINAL_POWER=480 ;;
				*650*|*UT650*|*BK650*) NOMINAL_POWER=360 ;;
				*600*) NOMINAL_POWER=360 ;;
				*500*|*TG500*) NOMINAL_POWER=300 ;;
				*400*) NOMINAL_POWER=240 ;;
				*) NOMINAL_POWER=360 ;;
			esac
		fi

		if [ -n "$LOAD_PCT" ] && [ -n "$NOMINAL_POWER" ]; then
			POWER=$(awk "BEGIN {printf \"%.1f\", ($LOAD_PCT * $NOMINAL_POWER / 100) * ${POWER_SCALE:-1.0}}" 2>/dev/null)
		fi
	fi

	# Atomic write status in tmpfs
	cat <<EOF > "${STATUS_FILE}.tmp"
{
	"connected": true,
	"status": "$STATUS_VAL",
	"is_online": $IS_OL,
	"is_on_battery": $IS_OB,
	"is_low_battery": $IS_LB,
	"battery_charge": ${CHARGE:-null},
	"battery_runtime": ${RUNTIME:-null},
	"battery_voltage": ${BATTERY_V:-null},
	"input_voltage": ${INPUT_V:-null},
	"input_freq": ${INPUT_FREQ:-null},
	"output_voltage": ${OUTPUT_V:-null},
	"output_freq": ${OUTPUT_FREQ:-null},
	"load_percent": ${LOAD_PCT:-null},
	"power": ${POWER:-null},
	"power_is_estimated": $POWER_ESTIMATED,
	"temperature": ${TEMP:-null},
	"model": "$MODEL",
	"manufacturer": "$MFR",
	"updated_at": $NOW
}
EOF
	mv "${STATUS_FILE}.tmp" "$STATUS_FILE"

	# Power grid event detection & debounce
	if [ $IS_OB -eq 1 ] && [ $PREV_ON_BATTERY -eq 0 ]; then
		ON_BATTERY_START_TS=$NOW
		log_event WARN "Power outage detected! Switched to battery power (Charge: ${CHARGE}%, Runtime: ${RUNTIME}s)."
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "power" "warn" "⚠️ Тревога: сеть отключена, переход на питание от батареи!" "Обнаружено отключение сети переменного тока (входное напряжение ${INPUT_V:-0.0} В). ИБП перешёл на питание от батареи (выход ${OUTPUT_V:-220.0} В, нагрузка ${LOAD_PCT:-0}%, заряд батареи ${CHARGE:-100}%)."
		if [ -x "$NOTIFY_SCRIPT" ]; then
			"$NOTIFY_SCRIPT" "on_battery" "Питание от сети пропало! ИБП перешёл на батарею (заряд: ${CHARGE}%, оценка работы: ${RUNTIME} с)" &
		fi
		PREV_ON_BATTERY=1
	elif [ $IS_OB -eq 0 ] && [ $PREV_ON_BATTERY -eq 1 ]; then
		outage_sec=$((NOW - ON_BATTERY_START_TS))
		ON_BATTERY_START_TS=0
		log_event INFO "Mains power restored after ${outage_sec}s. Running on line power."
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "power" "success" "⚡ Сеть восстановлена" "Входное напряжение сети в норме (${INPUT_V:-220.0} В / ${INPUT_FREQ:-50.0} Гц), отключение длилось ${outage_sec} с, выход питается от сети."
		if [ -x "$NOTIFY_SCRIPT" ]; then
			"$NOTIFY_SCRIPT" "online" "Питание от сети восстановлено! (без питания: ${outage_sec} с, заряд: ${CHARGE}%)" &
		fi
		PREV_ON_BATTERY=0
	fi

	# Low battery detection
	if [ $IS_LB -eq 1 ] && [ $PREV_LOW_BATTERY -eq 0 ]; then
		log_event CRIT "UPS battery is critically low! (Charge: ${CHARGE}%, Runtime: ${RUNTIME}s)."
		[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "power" "warn" "⚠️ Критично: заряд батареи ИБП очень низкий!" "Осталось ${CHARGE:-0}% заряда (ожидаемое время работы: ${RUNTIME:-0} с), скоро будет достигнут порог защитного выключения."
		if [ -x "$NOTIFY_SCRIPT" ]; then
			"$NOTIFY_SCRIPT" "low_battery" "Батарея ИБП критически низкая! Скоро порог защитного отключения (заряд: ${CHARGE}%)" &
		fi
		PREV_LOW_BATTERY=1
	elif [ $IS_LB -eq 0 ]; then
		PREV_LOW_BATTERY=0
	fi

	# Check shutdown policies
	SHUTDOWN_ENABLED=$(uci_get "${CONF}.shutdown.enabled" "1")
	if [ "$SHUTDOWN_ENABLED" = "1" ] && [ $IS_OB -eq 1 ]; then
		BATTERY_THRESHOLD=$(uci_get "${CONF}.shutdown.battery_low_percent" "20")
		RUNTIME_THRESHOLD=$(uci_get "${CONF}.shutdown.runtime_low_seconds" "300")
		DELAY_THRESHOLD=$(uci_get "${CONF}.shutdown.on_battery_delay" "600")

		TRIGGER_SHUTDOWN=0
		TRIGGER_REASON=""

		if [ -n "$CHARGE" ] && [ "$CHARGE" -le "$BATTERY_THRESHOLD" ] 2>/dev/null; then
			TRIGGER_SHUTDOWN=1
			TRIGGER_REASON="Battery charge ($CHARGE%) fell below limit ($BATTERY_THRESHOLD%)"
		elif [ -n "$RUNTIME" ] && [ "$RUNTIME" -le "$RUNTIME_THRESHOLD" ] 2>/dev/null; then
			TRIGGER_SHUTDOWN=1
			TRIGGER_REASON="Battery runtime ($RUNTIME s) fell below limit ($RUNTIME_THRESHOLD s)"
		elif [ "$DELAY_THRESHOLD" -gt 0 ] && [ $ON_BATTERY_START_TS -gt 0 ]; then
			ELAPSED=$((NOW - ON_BATTERY_START_TS))
			if [ $ELAPSED -ge "$DELAY_THRESHOLD" ]; then
				TRIGGER_SHUTDOWN=1
				TRIGGER_REASON="On battery duration ($ELAPSED s) exceeded delay limit ($DELAY_THRESHOLD s)"
			fi
		fi

		if [ $TRIGGER_SHUTDOWN -eq 1 ]; then
			log_event CRIT "Triggering automated emergency shutdown: $TRIGGER_REASON"
			[ -x "$LOG_SCRIPT" ] && "$LOG_SCRIPT" ops "ops" "warn" "🚨 Сработала автоматическая защита: аварийное выключение" "Причина выключения: $TRIGGER_REASON"
			if [ -x "$SHUTDOWN_SCRIPT" ]; then
				"$SHUTDOWN_SCRIPT" trigger "$TRIGGER_REASON" &
			fi
		fi
	fi

	# Robust Ring-buffer append in tmpfs (CSV format)
	# Fields: timestamp,input_v,output_v,charge,load,power,on_battery
	# Качество электроэнергии: отклонения по порогам UCI (гистерезис по порогам восстановления)
	quality_check in_volt_low "$INPUT_V" "$(uci_get ${CONF}.quality.in_volt_low_trig 190)" "$(uci_get ${CONF}.quality.in_volt_low_rec 200)" low 'Входное напряжение: низкое' warning
	quality_check in_volt_high "$INPUT_V" "$(uci_get ${CONF}.quality.in_volt_high_trig 250)" "$(uci_get ${CONF}.quality.in_volt_high_rec 245)" high 'Входное напряжение: высокое' warning
	quality_check in_freq_low "$INPUT_FREQ" "$(uci_get ${CONF}.quality.in_freq_low_trig 47)" "$(uci_get ${CONF}.quality.in_freq_low_rec 48)" low 'Входная частота: низкая' warning
	quality_check in_freq_high "$INPUT_FREQ" "$(uci_get ${CONF}.quality.in_freq_high_trig 53)" "$(uci_get ${CONF}.quality.in_freq_high_rec 52)" high 'Входная частота: высокая' warning
	quality_check load_high "$LOAD_PCT" "$(uci_get ${CONF}.quality.load_high_trig 80)" "$(uci_get ${CONF}.quality.load_high_rec 75)" high 'Нагрузка ИБП: высокая' warning
	quality_check load_crit "$LOAD_PCT" "$(uci_get ${CONF}.quality.load_crit_trig 95)" "$(uci_get ${CONF}.quality.load_crit_rec 90)" high 'Нагрузка ИБП: критическая' critical
	# Правила статуса ИБП (флаги NUT: OVER, BYPASS, RB, FAIL)
	status_rule status_overload_sev $(echo "$STATUS_VAL" | grep -q OVER && echo 1 || echo 0) 'Перегрузка ИБП' critical
	status_rule status_bypass_sev $(echo "$STATUS_VAL" | grep -q BYPASS && echo 1 || echo 0) 'ИБП перешёл в режим байпаса' warning
	status_rule status_replace_batt_sev $(echo "$STATUS_VAL" | grep -q RB && echo 1 || echo 0) 'Требуется замена батареи' warning
	status_rule status_selftest_fail_sev $(echo "$STATUS_VAL" | grep -q FAIL && echo 1 || echo 0) 'Ошибка самодиагностики ИБП' warning

	HISTORY_CSV="${RUNTIME_DIR}/history.csv"
	echo "$NOW,${INPUT_V:-0},${OUTPUT_V:-0},${CHARGE:-0},${LOAD_PCT:-0},${POWER:-0},$IS_OB" >> "$HISTORY_CSV"

	# Интегрирование энергии: P(W) x dt(s) / 3600 -> Wh. Пауза ограничена 30 с.
	DT=$((NOW - LAST_E_TS)); [ "$DT" -gt 30 ] && DT=30; [ "$DT" -lt 0 ] && DT=0
	LAST_E_TS=$NOW
	TODAY_NOW=$(date +%Y-%m-%d); MONTH_NOW=$(date +%Y-%m)
	[ "$TODAY_NOW" != "$TODAY_DATE" ] && { TODAY_WH=0; TODAY_DATE=$TODAY_NOW; }
	[ "$MONTH_NOW" != "$MONTH_KEY" ] && { MONTH_WH=0; MONTH_KEY=$MONTH_NOW; }
	PW=$(awk "BEGIN{p=$POWER+0; if (p<0) p=0; print p}" 2>/dev/null)
	ADD=$(awk "BEGIN{print $PW * $DT / 3600}" 2>/dev/null)
	TODAY_WH=$(awk "BEGIN{print $TODAY_WH + $ADD}")
	MONTH_WH=$(awk "BEGIN{print $MONTH_WH + $ADD}")
	if [ $((NOW % 60)) -lt 4 ] || [ "$DT" -ge 30 ]; then
		TODAY_KWH=$(awk "BEGIN{printf \"%.3f\", $TODAY_WH/1000}")
		MONTH_KWH=$(awk "BEGIN{printf \"%.3f\", $MONTH_WH/1000}")
		PEAK=$(awk -F',' 'BEGIN{m=0} {if ($6+0>m) m=$6+0} END{printf "%.1f", m}' "${RUNTIME_DIR}/history_1m.csv" 2>/dev/null)
		AVG=$(awk -F',' '{s+=$6; n++} END{ if (n>0) printf "%.1f", s/n; else print 0}' "${RUNTIME_DIR}/history_1m.csv" 2>/dev/null)
		[ -n "$PEAK" ] || PEAK=0
		[ -n "$AVG" ] || AVG=0
		echo "{\"today_kwh\":${TODAY_KWH:-0},\"month_kwh\":${MONTH_KWH:-0},\"today_wh\":${TODAY_WH:-0},\"month_wh\":${MONTH_WH:-0},\"peak_power\":${PEAK:-0},\"avg_power\":${AVG:-0},\"history\":[]}" > "$ENERGY_FILE.tmp" && mv "$ENERGY_FILE.tmp" "$ENERGY_FILE"
	fi

	# Минутные средние за сутки (1440 строк) в tmpfs: для диапазона 24 часа
	if [ $((NOW - LAST_MIN_TS)) -ge 60 ] && [ -s "$HISTORY_CSV" ]; then
		LAST_MIN_TS=$NOW
		HISTORY_1M="${RUNTIME_DIR}/history_1m.csv"
		tail -n 40 "$HISTORY_CSV" | awk -F',' -v ts="$NOW" 'BEGIN{n=0; vmin=999999; obc=0} {if (NF>=7) {v+=$2; vo+=$3; c+=$4; l+=$5; p+=$6; if ($7==1) obc++; ob=($7>ob?$7:ob); if ($2>0 && $2<vmin) vmin=$2; n++}} END { if (n>0) { if (vmin==999999) vmin=0; printf "%d,%.1f,%.1f,%.1f,%.1f,%.1f,%d,%.1f,%d\n", ts, v/n, vo/n, c/n, l/n, p/n, ob, vmin, obc } }' >> "$HISTORY_1M"
		if [ $(wc -l < "$HISTORY_1M" 2>/dev/null || echo 0) -gt 1500 ]; then
			tail -n 1440 "$HISTORY_1M" > "${HISTORY_1M}.tmp" && mv "${HISTORY_1M}.tmp" "$HISTORY_1M"
		fi
	fi

	# Periodic trim: keep last 1200 points (~1 hour at 3s)
	if [ $((NOW - LAST_FLUSH_TS)) -ge 60 ]; then
		LAST_FLUSH_TS=$NOW
		if [ $(wc -l < "$HISTORY_CSV" 2>/dev/null || echo 0) -gt 1300 ]; then
			tail -n 1200 "$HISTORY_CSV" > "${HISTORY_CSV}.tmp" && mv "${HISTORY_CSV}.tmp" "$HISTORY_CSV"
		fi
	fi

	sleep "$POLL_INTERVAL"
done
